# Default settings for the Makefiles (make syntax, no spaces around =).
# Put your own values into .env (not versioned); it overrides these defaults.

# Name of the workshop (.workshop/<WS>.yaml)
WS=n900

# The N900 for `make push`, reached over SSH, e.g. DEVICE=user@192.168.1.50
DEVICE=

# What gets copied to the device, and where
FILE=build/hello
# Caution: /home/user/MyDocs is FAT mounted noexec, binaries cannot be run from there.
# Use /home/user/... (ext3). Keep the trailing slash: without it scp would create a file
# named "apps" if the directory does not exist.
DEST=/home/user/apps/
