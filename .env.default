# Výchozí nastavení pro Makefile (syntaxe make, bez mezer kolem =).
# Vlastní hodnoty dej do .env (není ve verzování), ten tyto hodnoty přepíše.

# Jméno workshopu (.workshop/<WS>.yaml)
WS=n900

# N900 pro `make push`, přes SSH, např. DEVICE=user@192.168.1.50
DEVICE=

# Co se kopíruje na zařízení a kam
FILE=build/hello
DEST=/home/user/MyDocs/
