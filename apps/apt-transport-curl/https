#!/bin/bash
# apt method "https" on top of curl (/usr/bin/curl 8.x, TLS 1.2/1.3). Replaces the old method of apt-transport-https
# (libcurl with OpenSSL 0.9.8, TLS 1.0 only), which GitHub and most other servers refuse.
# Protocol: apt starts the method, reads "100 Capabilities", then sends "601 Configuration" and "600 URI Acquire" messages
# (header lines, an empty line ends a message) on stdin and gets "200 URI Start", "201 URI Done" or "400 URI Failure" on stdout.
# Honoured settings: Acquire::https::CaInfo (CA bundle), Acquire::https::Proxy, Acquire::https::Timeout,
# Acquire::https::Curl-Insecure "true" (no certificate check). NOT honoured: Acquire::https::Verify-Peer, because the
# phone ships Verify-Peer "false" in apt.conf.d, which would silently turn the verification off.
CURL=${CURL:-/usr/bin/curl}
CAINFO=; PROXY=; INSECURE=; TIMEOUT=60

# APT_CURL_DEBUG=/path/file writes the whole conversation with apt to that file.
dbg() { [ -z "${APT_CURL_DEBUG:-}" ] || printf '%s\n' "$*" >> "$APT_CURL_DEBUG"; }
# one write() per message: the old apt does not cope with a message that arrives in pieces
send() { local m; dbg ">> $*"; m=$(printf '%s\n' "$@"; printf x); printf '%s\n' "${m%x}"; }

# The apt 0.7 of the phone misses the first message when the method answers at once (the compiled methods are slower to start
# because of dynamic linking): a short pause is needed, found by experiment (an immediate printf hangs apt for ever).
sleep 0.2 2>/dev/null || /bin/true
send "100 Capabilities" "Version: 1.2" "Pipeline: true" "Send-Config: true"

failure() { # uri message
    send "400 URI Failure" "URI: $1" "Message: $2"
}

acquire() { # uri filename
    local uri=$1 file=$2 hdr err rc code opts=() lm size
    hdr=$(mktemp) && err=$(mktemp) || { failure "$uri" "mktemp failed"; return; }
    send "200 URI Start" "URI: $uri"
    opts=(-sS -L --proto =https,http --proto-redir =https,http --connect-timeout "$TIMEOUT" --speed-time "$TIMEOUT" --speed-limit 1
          -D "$hdr" -o "$file" -w '%{http_code}')
    [ -z "$CAINFO" ] || opts+=(--cacert "$CAINFO")
    [ -z "$PROXY" ] || opts+=(--proxy "$PROXY")
    [ -z "$INSECURE" ] || opts+=(-k)
    code=$("$CURL" "${opts[@]}" "$uri" 2> "$err")
    rc=$?
    if [ $rc -ne 0 ]; then
        failure "$uri" "$(tr '\r\n' '  ' < "$err" | cut -c1-200) (curl $rc)"
    elif [ "$code" != 200 ]; then
        rm -f "$file"
        failure "$uri" "HTTP $code"
    else
        # the headers of the last response (after redirects) hold the Last-Modified
        lm=$(grep -i '^last-modified:' "$hdr" | tail -n 1 | tr -d '\r' | sed 's/^[^:]*: *//')
        size=$(wc -c < "$file" | tr -d ' ')
        send "201 URI Done" "URI: $uri" "Filename: $file" "Size: $size" ${lm:+"Last-Modified: $lm"} \
             "MD5-Hash: $(md5sum < "$file" | cut -d' ' -f1)" "SHA1-Hash: $(sha1sum < "$file" | cut -d' ' -f1)" \
             "SHA256-Hash: $(sha256sum < "$file" | cut -d' ' -f1)"
    fi
    rm -f "$hdr" "$err"
}

config() { # Acquire::https::CaInfo=/path ...
    local k=${1%%=*} v=${1#*=}
    v=${v#\"}; v=${v%\"}
    case $k in
        Acquire::https::CaInfo)       CAINFO=$v ;;
        Acquire::https::Proxy)        [ "$v" = DIRECT ] && PROXY= || PROXY=$v ;;
        Acquire::https::Timeout)      TIMEOUT=$v ;;
        Acquire::https::Curl-Insecure) case $v in true|1|yes) INSECURE=1 ;; *) INSECURE= ;; esac ;;
    esac
}

first=; uri=; file=
while IFS= read -r line; do
    line=${line%$'\r'}
    dbg "<< $line"
    if [ -n "$line" ]; then
        if [ -z "$first" ]; then first=$line; continue; fi
        case $line in
            URI:*)         uri=${line#URI: } ;;
            Filename:*)    file=${line#Filename: } ;;
            Config-Item:*) config "${line#Config-Item: }" ;;
        esac
        continue
    fi
    case $first in
        600*) acquire "$uri" "$file" ;;
    esac
    first=; uri=; file=
done
dbg "== end of input"
