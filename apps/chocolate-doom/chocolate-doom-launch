#!/bin/sh
# Doom through Chocolate Doom. It looks for an IWAD (the game data: doom2.wad, doom.wad, plutonia.wad, tnt.wad, freedoom2.wad, freedoom1.wad) in
# MyDocs/doom, in ~/.local/share/games/doom and then anywhere in MyDocs (six levels deep, any letter case), and starts the first it finds
# (doom2 before doom, the commercial games before Freedoom). Freedoom (free game data, BSD licence): https://freedoom.github.io/
# SDL 2 on the phone has only the software renderer, and Chocolate Doom asks for another one when it starts: selected here.
export SDL_RENDER_DRIVER="${SDL_RENDER_DRIVER:-software}"
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-pulseaudio}"
cd "$HOME" 2>/dev/null || cd /
IWAD=
for n in doom2.wad doom.wad plutonia.wad tnt.wad freedoom2.wad freedoom1.wad; do
    for d in /home/user/MyDocs/doom "$HOME/.local/share/games/doom" "$HOME/MyDocs"; do
        [ -d "$d" ] || continue
        IWAD=$(find "$d" -maxdepth 6 -iname "$n" -type f 2>/dev/null | head -1)
        [ -n "$IWAD" ] && break 2
    done
done
if [ -z "$IWAD" ]; then
    msg="No IWAD found. Copy doom.wad, doom2.wad or freedoom1.wad / freedoom2.wad (https://freedoom.github.io/) into /home/user/MyDocs/doom and start again."
    echo "$msg" >&2
    dbus-send --session --type=method_call --dest=org.freedesktop.Notifications /org/freedesktop/Notifications \
        org.freedesktop.Notifications.SystemNoteInfoprint "string:Chocolate Doom: $msg" >/dev/null 2>&1 || true
    exit 1
fi
# the start takes about half a minute (the sound effects are prepared): say so
dbus-send --session --type=method_call --dest=org.freedesktop.Notifications /org/freedesktop/Notifications \
    org.freedesktop.Notifications.SystemNoteInfoprint "string:Chocolate Doom is starting, wait a moment. Menu: Backspace." >/dev/null 2>&1 || true
exec /opt/chocolate-doom/bin/chocolate-doom -iwad "$IWAD" -extraconfig /opt/chocolate-doom/share/n900.cfg "$@"
