# cointop (a cryptocurrency tracker for the terminal; the upstream repository is archived since 2024, the last release 1.6.10 still works): Go, static binary
# (patched Go toolchain of apps/go). Targets and conventions: ../../mk/app.mk
override APP     := cointop
VERSION ?= 1.6.10
REV     ?= 1maemo1
RUN_CMD := TERM=xterm /usr/bin/cointop version
include ../../mk/app.mk
