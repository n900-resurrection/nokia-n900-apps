# copyparty: file server (browser upload and download, one Python file); the N900 package adds the unpacked tree, the command
# copyparty-share and a menu entry. Targets and conventions: ../../mk/app.mk
override APP     := copyparty
VERSION ?= 1.20.26
REV     ?= 1maemo2
RUN_CMD := TERM=xterm copyparty --version | head -n 3
include ../../mk/app.mk
