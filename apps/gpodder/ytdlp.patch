diff -ruN a/src/gpodder/ytdlp.py b/src/gpodder/ytdlp.py
--- a/src/gpodder/ytdlp.py	1970-01-01 01:00:00.000000000 +0100
+++ b/src/gpodder/ytdlp.py	2026-11-06 22:19:19.636529786 +0100
@@ -0,0 +1,303 @@
+# -*- coding: utf-8 -*-
+#
+# gpodder.ytdlp - external helpers for the Maemo 5 port: yt-dlp (YouTube) and curl (HTTPS)
+#
+# The Python 2.5 of the N900 speaks TLS 1.0 only, which today's servers refuse, and the old YouTube code of gPodder is gone for good.
+# So HTTPS goes through curl 8 (package "curl", mbedTLS, TLS 1.3) and YouTube links are resolved by yt-dlp (+ QuickJS).
+#
+# Plain HTTP stays with urllib; only the https:// URLs of feeds, enclosures and YouTube videos come here.
+
+import BaseHTTPServer
+import SocketServer
+import md5
+import os
+import re
+import signal
+import socket
+import subprocess
+import threading
+import tempfile
+import urllib
+import time
+
+CURL_CANDIDATES = ('/opt/curl/bin/curl', '/usr/bin/curl')
+CACERT_CANDIDATES = ('/opt/curl/etc/ssl/cacert.pem', '/etc/ssl/certs/ca-certificates.crt')
+YTDLP_CANDIDATES = (os.path.expanduser('~/.local/bin/yt-dlp'), '/opt/yt-dlp/bin/yt-dlp', '/usr/local/bin/yt-dlp', '/usr/bin/yt-dlp')
+QJS_CANDIDATES = ('/usr/bin/qjs', '/opt/quickjs/bin/qjs')
+
+# Format for the Maemo media player: small progressive MP4 (itag 18, 360p), otherwise the best file up to 480p that holds audio and video
+YTDLP_FORMAT = '18/b[height<=480][ext=mp4]/b[height<=480]/b'
+
+
+class FetchError(Exception):
+    pass
+
+
+class YtdlpError(Exception):
+    pass
+
+
+def _first(paths):
+    for p in paths:
+        if os.path.exists(p):
+            return p
+    return None
+
+
+def _kill(p):
+    """Popen.kill() does not exist in Python 2.5."""
+    try:
+        os.kill(p.pid, signal.SIGKILL)
+    except OSError:
+        pass
+    try:
+        p.wait()
+    except OSError:
+        pass
+
+
+def needs_curl(url):
+    return url.lower().startswith('https://')
+
+
+def curl_command(url, extra=()):
+    curl = _first(CURL_CANDIDATES)
+    if curl is None:
+        raise FetchError('curl is not installed (package "curl")')
+    cmd = [curl, '-sS', '-L', '--max-redirs', '10', '--connect-timeout', '30']
+    cacert = _first(CACERT_CANDIDATES)
+    if cacert:
+        cmd += ['--cacert', cacert]
+    return cmd + list(extra) + [url]
+
+
+def _read_headers(path):
+    """Headers of the last response in a curl -D file as a dict with lower case names."""
+    headers = {}
+    try:
+        f = open(path)
+        try:
+            text = f.read()
+        finally:
+            f.close()
+    except IOError:
+        return headers
+    blocks = [b for b in re.split(r'\r?\n\r?\n', text) if b.strip()]
+    if blocks:
+        for line in blocks[-1].splitlines()[1:]:
+            if ':' in line:
+                k, v = line.split(':', 1)
+                headers[k.strip().lower()] = v.strip()
+    return headers
+
+
+def fetch(url, user_agent=None):
+    """Download a small document (a feed). Returns (data, http status, headers dict)."""
+    fd, hdr = tempfile.mkstemp(prefix='gpodder-curl-')
+    os.close(fd)
+    try:
+        extra = ['-D', hdr, '-w', '\n%{http_code}']
+        if user_agent:
+            extra += ['-A', user_agent]
+        p = subprocess.Popen(curl_command(url, extra), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        out, err = p.communicate()
+        if p.returncode != 0:
+            raise FetchError(err.strip() or ('curl exit status %d' % p.returncode))
+        body, _, code = out.rpartition('\n')
+        return body, int(code or 0), _read_headers(hdr)
+    finally:
+        try:
+            os.remove(hdr)
+        except OSError:
+            pass
+
+
+def retrieve(url, filename, reporthook=None, user_agent=None):
+    """Download url to filename (resumes a partial file). reporthook(count, blocksize, totalsize) is called every
+    0.3 s and may raise to stop the transfer (cancel, pause). Returns (headers, url). Errors: FetchError, IOError."""
+    block = 8192
+    fd, hdr = tempfile.mkstemp(prefix='gpodder-curl-')
+    os.close(fd)
+    start = os.path.exists(filename) and os.path.getsize(filename) or 0
+    extra = ['-D', hdr, '-C', '-', '--fail', '-o', filename]
+    if user_agent:
+        extra += ['-A', user_agent]
+    p = subprocess.Popen(curl_command(url, extra), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    try:
+        total = 0
+        while p.poll() is None:
+            time.sleep(0.3)
+            if not total:
+                length = _read_headers(hdr).get('content-length')
+                if length and length.isdigit():
+                    total = start + int(length)
+            size = os.path.exists(filename) and os.path.getsize(filename) or 0
+            if reporthook is not None:
+                reporthook(size // block, block, total)
+        err = p.stderr.read().strip()
+        if p.returncode == 33:
+            # the server cannot resume (a complete file is already there): start again
+            os.remove(filename)
+            return retrieve(url, filename, reporthook, user_agent)
+        if p.returncode != 0:
+            raise FetchError(err or ('curl exit status %d' % p.returncode))
+        headers = _read_headers(hdr)
+        size = os.path.getsize(filename)
+        if reporthook is not None:
+            reporthook(size // block + 1, block, size)
+        return headers, url
+    finally:
+        if p.poll() is None:
+            _kill(p)
+        try:
+            os.remove(hdr)
+        except OSError:
+            pass
+
+
+def ytdlp_command():
+    exe = _first(YTDLP_CANDIDATES) or os.environ.get('GPODDER_YTDLP')
+    if not exe:
+        raise YtdlpError('yt-dlp is not installed (~/.local/bin/yt-dlp)')
+    cmd = [exe, '--no-playlist', '--no-warnings', '--no-cache-dir']
+    qjs = _first(QJS_CANDIDATES)
+    if qjs:
+        cmd += ['--js-runtimes', 'quickjs:' + qjs]
+    return cmd
+
+
+def _tmp_env():
+    """The /tmp of the phone is tiny and yt-dlp writes temporary files while it solves the JavaScript challenge of YouTube
+    ("No space left on device"): use a directory in the home of the user."""
+    env = dict(os.environ)
+    tmp = os.path.expanduser('~/.gpodder/tmp')
+    try:
+        if not os.path.isdir(tmp):
+            os.makedirs(tmp)
+        env['TMPDIR'] = tmp
+    except OSError:
+        pass
+    return env
+
+
+def resolve(url, fmt=YTDLP_FORMAT):
+    """Direct media URL of a YouTube (or other yt-dlp supported) page."""
+    cmd = ytdlp_command() + ['-f', fmt, '-g', url]
+    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=_tmp_env())
+    out, err = p.communicate()
+    lines = [l for l in out.splitlines() if l.strip()]
+    if p.returncode != 0 or not lines:
+        raise YtdlpError(err.strip().splitlines()[-1] if err.strip() else ('yt-dlp exit status %d' % p.returncode))
+    return lines[0]
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Streaming: the Nokia media player (MAFW/GStreamer) cannot open https:// URLs. A tiny HTTP server on 127.0.0.1 hands it
+# http://127.0.0.1:PORT/<id>.<ext> and fetches the real https URL with curl (Range requests pass through, so seeking works).
+
+PROXY_HEADERS = ('content-type', 'content-length', 'content-range', 'accept-ranges', 'last-modified')
+
+_proxy_lock = threading.Lock()
+_proxy = None
+_targets = {}
+
+
+class _ProxyHandler(BaseHTTPServer.BaseHTTPRequestHandler):
+    protocol_version = 'HTTP/1.0'
+
+    def log_message(self, *args):
+        pass
+
+    def do_HEAD(self):
+        self._serve(True)
+
+    def do_GET(self):
+        self._serve(False)
+
+    def _read_block(self, f):
+        """Header lines of one response (status line + headers) read from the curl pipe; None at EOF."""
+        lines = []
+        while True:
+            line = f.readline()
+            if not line:
+                return None
+            line = line.rstrip('\r\n')
+            if not line:
+                if lines:
+                    return lines
+                continue
+            lines.append(line)
+
+    def _serve(self, head):
+        url = _targets.get(self.path.lstrip('/').split('/')[0].split('.')[0])
+        if url is None:
+            self.send_error(404)
+            return
+        extra = ['-i']
+        if head:
+            extra = ['-I']
+        if self.headers.get('Range'):
+            extra += ['-H', 'Range: ' + self.headers.get('Range')]
+        try:
+            p = subprocess.Popen(curl_command(url, extra), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        except (OSError, FetchError):
+            self.send_error(502)
+            return
+        try:
+            # with -L curl prints the headers of every redirect first: skip blocks with a 3xx status
+            while True:
+                block = self._read_block(p.stdout)
+                if block is None:
+                    self.send_error(502)
+                    return
+                try:
+                    status = int(block[0].split()[1])
+                except (IndexError, ValueError):
+                    status = 502
+                if not 300 <= status < 400:
+                    break
+            self.send_response(status)
+            for line in block[1:]:
+                if ':' in line:
+                    k, v = line.split(':', 1)
+                    if k.strip().lower() in PROXY_HEADERS:
+                        self.send_header(k.strip(), v.strip())
+            self.end_headers()
+            if head:
+                return
+            while True:
+                data = os.read(p.stdout.fileno(), 65536)
+                if not data:
+                    break
+                self.wfile.write(data)
+        except (socket.error, IOError):
+            pass    # the player closed the connection (seek, stop)
+        finally:
+            if p.poll() is None:
+                _kill(p)
+
+
+class _ProxyServer(SocketServer.ThreadingMixIn, BaseHTTPServer.HTTPServer):
+    daemon_threads = True
+    allow_reuse_address = True
+
+
+def stream_url(url, ext='mp3', title=None):
+    """http://127.0.0.1 URL through which the media player can stream the https URL. The media player shows the last part
+    of the path as the name of the track, so it carries the title (the first part is the key of the stream)."""
+    global _proxy
+    key = md5.new(url).hexdigest()[:16]
+    _proxy_lock.acquire()
+    try:
+        if _proxy is None:
+            _proxy = _ProxyServer(('127.0.0.1', 0), _ProxyHandler)
+            t = threading.Thread(target=_proxy.serve_forever)
+            t.setDaemon(True)
+            t.start()
+        _targets[key] = url
+        name = re.sub(r'[\\/?#%:*"<>|\x00-\x1f]+', ' ', title or '').strip()[:100].strip()
+        if isinstance(name, unicode):
+            name = name.encode('utf-8')
+        return 'http://127.0.0.1:%d/%s/%s.%s' % (_proxy.server_address[1], key, urllib.quote(name or 'stream'), ext)
+    finally:
+        _proxy_lock.release()
