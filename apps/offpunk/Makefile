# offpunk (an offline-first reader of Gemini, Gopher, the web and RSS for the terminal): Python 3, pure Python with the pure Python libraries it needs
# (requests, beautifulsoup4, feedparser, ...) in one folder. Targets and conventions: ../../mk/app.mk
override APP     := offpunk
REV     ?= 1maemo1
VERSION ?= 3.1
DEPS    := python3
RUN_CMD := TERM=xterm /usr/bin/offpunk --version
include ../../mk/app.mk
