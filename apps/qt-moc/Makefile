# qt-moc: the Qt 4.7 meta-object compiler (moc) for the BUILD host, needed to cross-build Qt 4.7 programs for Maemo 5 (no package for the phone).
# Targets and conventions: ../../mk/app.mk. `make qt-moc` builds it; the result is build/out/qt-moc-4.7.4/bin/moc.
override APP := qt-moc
VERSION ?= 4.7.4
include ../../mk/app.mk
