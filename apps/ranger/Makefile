# ranger (console file manager in Python 3) for Maemo 5. Targets and conventions: ../../mk/app.mk
override APP     := ranger
REV     ?= 1maemo2
VERSION ?= 1.9.4
DEPS    := python3
RUN_CMD := TERM=xterm /usr/bin/ranger --version
EMU_BIN := /project/build/out/ranger-$(VERSION)/root/usr/bin/ranger
include ../../mk/app.mk
