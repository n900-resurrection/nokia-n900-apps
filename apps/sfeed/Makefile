# sfeed (RSS/Atom reader from small tools) for Maemo 5. Targets and conventions: ../../mk/app.mk
override APP     := sfeed
REV     ?= 1maemo4
VERSION ?= 2.4
RUN_CMD := /usr/bin/sfeed_plain -h 2>&1 | head -3
EMU_BIN := /project/build/out/sfeed-$(VERSION)/root/opt/sfeed/bin/sfeed
include ../../mk/app.mk
