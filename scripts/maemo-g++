#!/bin/sh
# Wrapper around arm-linux-gnueabi-g++ for Maemo 5 (Fremantle, armel, glibc 2.5), like maemo-gcc for C. Run inside the Workshop.
# The C++ library is the one of the Ubuntu cross compiler, linked STATICALLY (the system libstdc++ is 4.2.1, too old for C++11 and later).
# That library was built for glibc 2.39, so scripts/maemo-cxx-compat.c supplies the few newer symbols it asks for (compiled on each call, it is tiny).
# Usage: like g++: scripts/maemo-g++ -std=gnu++17 -O2 a.cpp -o a -lSDL ...
SR="${MAEMO_SYSROOT:-/project/sysroot}"
HERE="$(cd "$(dirname "$0")" && pwd)"
GCCINC="$(arm-linux-gnueabi-gcc -print-file-name=include)"
CXXINC="/usr/arm-linux-gnueabi/include/c++/13"
DEPFLAGS=
for d in $(printf '%s' "${MAEMO_DEPS:-}" | tr ':' ' '); do
    DEPFLAGS="$DEPFLAGS -isystem $d/include -L$d/lib"
done
SHIM="$(mktemp /tmp/maemo-cxx-compat.XXXXXX.o)"
trap 'rm -f "$SHIM"' EXIT
"$HERE/maemo-gcc" -O2 -c "$HERE/maemo-cxx-compat.c" -o "$SHIM" || exit 1
# shellcheck disable=SC2086
arm-linux-gnueabi-g++ $DEPFLAGS \
    --sysroot="$SR" -B"$SR/usr/lib" -L"$SR/usr/lib" -L"$SR/lib" \
    -nostdinc -nostdinc++ -isystem "$CXXINC" -isystem "$CXXINC/arm-linux-gnueabi" -isystem "$CXXINC/backward" -isystem "$GCCINC" -isystem "$SR/usr/include" \
    -march=armv7-a -mfpu=neon -mfloat-abi=softfp \
    -include "$HERE/maemo-compat.h" -include "$HERE/maemo-cxx-compat.h" -fuse-ld=gold -Wl,--hash-style=both \
    -static-libstdc++ -static-libgcc "$@" "$SHIM" -lpthread -lrt
