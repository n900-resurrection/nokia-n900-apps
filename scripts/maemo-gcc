#!/bin/sh
# Wrapper around arm-linux-gnueabi-gcc for Maemo 5 (Fremantle, armel, glibc 2.5).
# C only. Run inside the Workshop; the sysroot is created by scripts/fetch_sysroot.py.
#
# Why these options (verified 2026-11-03: Ubuntu 24.04 + gcc 13.3 + a sysroot from the Fremantle SDK):
#  - Ubuntu's cross-gcc looks for its own libc (glibc 2.39) in /usr/arm-linux-gnueabi/lib before the
#    sysroot, so the result would require GLIBC_2.34 (__libc_start_main). Hence -B/-L/-nostdinc.
#  - ld.bfd 2.42 crashes on an assertion in elf32-arm.c when given the glibc 2.5 objects;
#    -fuse-ld=gold works.
#  - --hash-style=both so that the older dynamic linker copes as well. [to verify] on the device.
#  - -fgnu89-inline: the glibc 2.5 headers use GNU89-style "extern inline". In C99 mode (gnu99, e.g.
#    WordGrinder) the assembler otherwise reports "symbol stat64 is already defined".
#  - MAEMO_DEPS (optional, colon-separated prefixes, e.g. /project/build/deps/zlib-1.3.2:...):
#    their include/ and lib/ are searched BEFORE the sysroot. Needed when a newer library is built
#    privately, because the old one in the sysroot (e.g. zlib 1.2.3) would otherwise win. The
#    include directories are given as -isystem BEFORE the sysroot one: GCC ignores a plain -I for a
#    directory that is also passed as -isystem (curl does that), which would put it after the sysroot.
SR="${MAEMO_SYSROOT:-/project/sysroot}"
GCCINC="$(arm-linux-gnueabi-gcc -print-file-name=include)"
DEPFLAGS=
for d in $(printf '%s' "${MAEMO_DEPS:-}" | tr ':' ' '); do
    DEPFLAGS="$DEPFLAGS -isystem $d/include -L$d/lib"
done
# shellcheck disable=SC2086  # DEPFLAGS is intentionally split into words
exec arm-linux-gnueabi-gcc $DEPFLAGS \
    --sysroot="$SR" -B"$SR/usr/lib" -L"$SR/usr/lib" -L"$SR/lib" \
    -nostdinc -isystem "$GCCINC" -isystem "$SR/usr/include" \
    -march=armv7-a -mfpu=neon -mfloat-abi=softfp \
    -fgnu89-inline \
    -fuse-ld=gold -Wl,--hash-style=both \
    "$@"
